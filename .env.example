# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Server ---
PORT=3000

# --- MySQL database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=salonease
DB_USER=root
DB_PASSWORD=change-me

# --- Public app (used to build customer manage links) ---
PUBLIC_APP_URL=http://localhost:5173

# --- CORS ---
# Comma-separated origins allowed to call the API with credentials (the
# httpOnly session cookie). Falls back to PUBLIC_APP_URL when unset.
# CORS is disabled entirely when neither variable is set.
CORS_ORIGINS=http://localhost:5173

# --- Auth (used from Phase 3) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# --- Seed credentials (used only by `pnpm run seed`) ---
# IMPORTANT: dotenv treats "#" as the start of an inline comment. Avoid "#" in
# values (or wrap the value in quotes), otherwise the value is silently truncated.
SEED_OWNER_USERNAME=owner
SEED_OWNER_EMAIL=owner@raheemsalon.local
SEED_OWNER_PASSWORD=change-me-owner-password
SEED_STAFF_PASSWORD=change-me-staff-password
